---
interface Props {
  title: string;
  description?: string;
}
const { title, description = "Find hackathons actually worth entering - OpenCode Go, Cloudflare, Groq, OpenRouter and more" } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style is:global>
      :root {
        --bg: #090b10;
        --surface: #111827;
        --surface-hover: #1a2236;
        --border: #1e293b;
        --text: #f1f5f9;
        --text-muted: #94a3b8;
        --text-dim: #64748b;
        --accent: #f97316;
        --accent-dim: #16a34a;
        --blue: #3b82f6;
        --purple: #a855f7;
        --orange: #f97316;
        --red: #ef4444;
        --yellow: #eab308;
        --cyan: #06b6d4;
        --pink: #ec4899;
      }
      * { box-sizing: border-box; margin: 0; padding: 0; }
      body {
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        background: var(--bg);
        color: var(--text);
        line-height: 1.5;
        min-height: 100vh;
        -webkit-font-smoothing: antialiased;
      }
      a { color: var(--accent); text-decoration: none; }
      a:hover { text-decoration: underline; }
      .container { max-width: 1280px; margin: 0 auto; padding: 0 20px; }
      header {
        border-bottom: 1px solid var(--border);
        background: rgba(9,11,16,0.95);
        backdrop-filter: blur(16px);
        position: sticky; top: 0; z-index: 100;
      }
      nav { display: flex; align-items: center; justify-content: space-between; padding: 14px 0; }
      .logo { font-size: 20px; font-weight: 800; letter-spacing: -0.03em; text-decoration: none; }
      .logo span { color: var(--accent); }
      .nav-links { display: flex; gap: 20px; font-size: 13px; color: var(--text-muted); }
      .nav-links a { color: var(--text-muted); text-decoration: none; }
      .nav-links a:hover { color: var(--text); }
      main { padding: 32px 0 64px; }
      h1 { font-size: clamp(28px,4vw,42px); font-weight: 800; letter-spacing: -0.03em; line-height: 1.1; margin-bottom: 8px; }
      h2 { font-size: 20px; font-weight: 700; letter-spacing: -0.02em; margin-bottom: 12px; }
      .subtitle { color: var(--text-muted); font-size: 15px; max-width: 600px; line-height: 1.6; }
      .eyebrow { color: var(--accent); text-transform: uppercase; letter-spacing: 0.08em; font-size: 11px; font-weight: 700; margin-bottom: 8px; }
      .toolbar { display: flex; gap: 10px; align-items: center; justify-content: space-between; margin: 20px 0 12px; flex-wrap: wrap; }
      input, select {
        background: var(--surface); color: var(--text); border: 1px solid var(--border);
        border-radius: 8px; padding: 8px 12px; font-size: 13px; outline: none; transition: border-color 0.15s;
      }
      input:focus, select:focus { border-color: var(--accent); }
      input[type="search"] { min-width: 240px; }
      .stats { color: var(--text-dim); font-size: 12px; }
      .table-wrap {
        background: var(--surface); border: 1px solid var(--border); border-radius: 10px; overflow: hidden;
      }
      table { width: 100%; border-collapse: collapse; }
      th, td { text-align: left; padding: 11px 14px; border-bottom: 1px solid var(--border); }
      th {
        background: rgba(17,24,39,0.6); color: var(--text-dim); font-size: 10px;
        text-transform: uppercase; letter-spacing: 0.06em; font-weight: 600; cursor: pointer;
        user-select: none; white-space: nowrap;
      }
      th:hover { color: var(--text-muted); }
      th.sorted-asc::after { content: " ↑"; color: var(--accent); }
      th.sorted-desc::after { content: " ↓"; color: var(--accent); }
      tr:last-child td { border-bottom: none; }
      tr:hover td { background: var(--surface-hover); }
      .model-name { font-weight: 600; font-size: 14px; }
      .model-sub { color: var(--text-dim); font-size: 11px; margin-top: 1px; }
      .provider-badge {
        display: inline-flex; align-items: center; gap: 5px;
        padding: 3px 8px; border-radius: 6px; font-size: 11px; font-weight: 600;
        background: rgba(255,255,255,0.05); border: 1px solid var(--border);
      }
      .provider-dot { width: 6px; height: 6px; border-radius: 50%; }
      .dot-opencode { background: var(--accent); }
      .dot-cloudflare { background: var(--orange); }
      .dot-google_ai { background: var(--blue); }
      .dot-groq { background: var(--purple); }
      .dot-openrouter { background: var(--cyan); }
      .dot-cerebras { background: var(--pink); }
      .dot-huggingface { background: var(--yellow); }
      .dot-github { background: var(--text); }
      .dot-mistral { background: var(--red); }
      .price { font-weight: 600; font-variant-numeric: tabular-nums; font-size: 13px; }
      .price-free { color: var(--accent); }
      .price-low { color: var(--accent); }
      .price-mid { color: var(--yellow); }
      .price-high { color: var(--orange); }
      .badge {
        display: inline-flex; padding: 2px 7px; border-radius: 5px;
        font-size: 10px; font-weight: 700; letter-spacing: 0.02em;
      }
      .badge-free { background: rgba(34,197,94,0.15); color: var(--accent); }
      .badge-deal { background: rgba(59,130,246,0.15); color: var(--blue); }
      .badge-type { background: rgba(168,85,247,0.15); color: var(--purple); }
      .badge-verified { background: rgba(34,197,94,0.1); color: var(--accent); }
      .deal-card {
        background: var(--surface); border: 1px solid var(--border); border-radius: 10px;
        padding: 16px; margin-bottom: 10px; transition: border-color 0.15s;
      }
      .deal-card:hover { border-color: var(--accent); }
      .deal-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 8px; }
      .deal-provider { font-size: 12px; color: var(--text-dim); }
      .deal-title { font-weight: 600; font-size: 15px; }
      .deal-terms { color: var(--text-muted); font-size: 13px; margin: 6px 0; }
      .deal-value { font-size: 24px; font-weight: 800; color: var(--accent); letter-spacing: -0.03em; }
      .deal-meta { display: flex; gap: 12px; margin-top: 10px; font-size: 11px; color: var(--text-dim); }
      .tabs { display: inline-flex; gap: 2px; background: var(--surface); border: 1px solid var(--border); border-radius: 8px; padding: 3px; }
      .tab { background: transparent; border: none; color: var(--text-dim); padding: 6px 12px; font-size: 12px; font-weight: 600; border-radius: 6px; cursor: pointer; }
      .tab:hover { color: var(--text); }
      .tab.active { background: rgba(34,197,94,0.15); color: var(--accent); }
      .tile-grid { display:grid; grid-template-columns:repeat(5,minmax(0,1fr)); gap:10px; }
      .tile {
        display:flex; flex-direction:column; justify-content:space-between;
        min-height:130px; padding:12px; border-radius:12px;
        border:1px solid var(--border); text-decoration:none !important; color:inherit;
        transition:transform .12s ease, box-shadow .12s ease;
      }
      .tile:hover { transform:translateY(-3px); box-shadow:0 6px 18px rgba(0,0,0,.45); }
      .tile-top { display:flex; justify-content:space-between; align-items:center; margin-bottom:8px; }
      .tile-score { font-size:15px; font-weight:900; color:var(--accent); }
      .tile-action { font-size:9px; font-weight:800; padding:2px 6px; border-radius:5px; text-transform:uppercase; letter-spacing:.03em; }
      .act-ENTERNOW { background:rgba(34,197,94,.18); color:#86efac; }
      .act-SPRINT { background:rgba(249,115,22,.18); color:#fdba74; }
      .act-PREP { background:rgba(59,130,246,.15); color:#93c5fd; }
      .act-WATCH { background:rgba(148,163,163,.15); color:var(--text-dim); }
      .tile-mega { font-size:12px; }
      .tile-title {
        font-size:12px; font-weight:700; line-height:1.3; color:var(--text);
        display:-webkit-box; -webkit-line-clamp:3; -webkit-box-orient:vertical; overflow:hidden;
        margin-bottom:6px;
      }
      .tile-title { color:var(--text); text-decoration:none; }
      .tile:hover .tile-title { color:var(--accent); }
      .tile-official {
        font-size:12px; font-weight:800; color:var(--text-dim);
        border:1px solid var(--border); border-radius:5px; padding:0 5px; line-height:16px;
        text-decoration:none !important; background:rgba(255,255,255,0.04);
      }
      .tile-official:hover { color:var(--accent); border-color:var(--accent); }
      .tile-org { font-size:10px; color:var(--text-dim); margin-bottom:8px;
        white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
      .tile-bottom { display:flex; justify-content:space-between; align-items:center; }
      .tile-prize { font-size:12px; font-weight:800; font-variant-numeric:tabular-nums; color:var(--text); }
      .tile-days { font-size:11px; font-weight:800; white-space:nowrap; }
      @media(max-width:1100px){ .tile-grid{grid-template-columns:repeat(4,1fr);} }
      @media(max-width:900px){ .tile-grid{grid-template-columns:repeat(3,1fr);} }
      @media(max-width:650px){ .tile-grid{grid-template-columns:repeat(2,1fr);} }
      @media(max-width:420px){ .tile-grid{grid-template-columns:1fr;} }
      .deal-list { display: flex; flex-direction: column; gap: 16px; }
      .deal-full {
        background: var(--surface); border: 1px solid var(--border); border-radius: 14px;
        display: flex; gap: 0; overflow: hidden;
      }
      .deal-rank {
        background: rgba(34,197,94,0.08); color: var(--accent); font-size: 24px; font-weight: 900;
        display: flex; align-items: flex-start; justify-content: center; padding: 24px 20px;
        min-width: 70px; letter-spacing: -0.03em; border-right: 1px solid var(--border);
      }
      .deal-body { flex: 1; padding: 20px 24px; }
      .deal-head { margin-bottom: 16px; }
      .deal-title { font-size: 18px; font-weight: 700; margin-bottom: 2px; }
      .deal-tagline { font-size: 13px; color: var(--text-dim); }
      .deal-section { margin-bottom: 10px; }
      .deal-section-label {
        font-size: 10px; text-transform: uppercase; letter-spacing: 0.06em;
        font-weight: 700; color: var(--accent); margin-bottom: 3px;
      }
      .deal-section-text { font-size: 13px; color: var(--text-muted); line-height: 1.5; }
      .deal-catch { color: var(--orange) !important; }
      .deal-footer { margin-top: 14px; padding-top: 12px; border-top: 1px solid var(--border); }
      .deal-link { font-size: 12px; font-weight: 600; }
      @media (max-width: 600px) {
        .deal-full { flex-direction: column; }
        .deal-rank { border-right: none; border-bottom: 1px solid var(--border); padding: 12px; min-width: auto; }
      }
      .hero { margin-bottom: 32px; }
      .section-gap { margin-top: 48px; }
      .section-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 16px; }
      .see-all { font-size: 13px; color: var(--text-dim); }
      .see-all:hover { color: var(--accent); }
      .top-deals { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 12px; }
      .deal-card {
        background: var(--surface); border: 1px solid var(--border); border-radius: 12px;
        padding: 18px; transition: border-color 0.15s, transform 0.15s; cursor: pointer;
      }
      .deal-card:hover { border-color: var(--accent); transform: translateY(-2px); }
      .deal-card-header { display: flex; align-items: center; gap: 8px; margin-bottom: 10px; }
      .rank-badge {
        display: inline-flex; align-items: center; justify-content: center;
        width: 28px; height: 28px; border-radius: 8px; font-size: 12px; font-weight: 800;
      }
      .badge-exceptional { background: rgba(34,197,94,0.15); color: var(--accent); }
      .badge-excellent { background: rgba(59,130,246,0.15); color: var(--blue); }
      .badge-good { background: rgba(234,179,8,0.15); color: var(--yellow); }
      .badge-niche { background: rgba(100,116,139,0.15); color: var(--text-dim); }
      .rating-text { font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-dim); }
      .deal-card-title { font-size: 16px; font-weight: 700; margin-bottom: 6px; }
      .deal-card-price { font-size: 14px; font-weight: 700; color: var(--accent); margin-bottom: 2px; }
      .deal-card-volume { font-size: 12px; color: var(--text-dim); margin-bottom: 10px; }
      .deal-card-why { font-size: 13px; color: var(--text-muted); line-height: 1.5; margin-bottom: 12px; }
      .deal-card-meta { font-size: 11px; color: var(--text-dim); margin-bottom: 12px; }
      .deal-card-meta div { margin-bottom: 4px; }
      .meta-label { font-weight: 600; color: var(--text-muted); }
      .deal-card-cta { font-size: 12px; font-weight: 600; color: var(--accent); }
      .spotlight-section { margin-top: 48px; }
      .spotlight-card {
        background: linear-gradient(135deg, rgba(34,197,94,0.08), rgba(59,130,246,0.05));
        border: 1px solid rgba(34,197,94,0.2); border-radius: 14px; padding: 28px;
      }
      .spotlight-badge {
        display: inline-block; background: rgba(34,197,94,0.15); color: var(--accent);
        padding: 4px 10px; border-radius: 6px; font-size: 11px; font-weight: 700;
        text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 12px;
      }
      .spotlight-title { font-size: 22px; font-weight: 800; margin-bottom: 12px; letter-spacing: -0.02em; }
      .spotlight-summary { font-size: 14px; color: var(--text-muted); line-height: 1.6; margin-bottom: 16px; }
      .spotlight-highlights { margin: 0 0 16px 18px; padding: 0; }
      .spotlight-highlights li { font-size: 13px; color: var(--text-muted); margin-bottom: 6px; }
      .spotlight-highlights li::marker { color: var(--accent); }
      .spotlight-cta { font-size: 13px; font-weight: 600; }
      .providers-section { margin-top: 48px; }
      .providers-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(160px, 1fr)); gap: 10px; }
      .provider-card {
        background: var(--surface); border: 1px solid var(--border); border-radius: 10px;
        padding: 14px; display: flex; align-items: center; gap: 10px;
      }
      .provider-name { font-size: 13px; font-weight: 600; }
      .provider-meta { font-size: 11px; color: var(--text-dim); }
      @media (max-width: 768px) {
        .toolbar { flex-direction: column; align-items: stretch; }
        input[type="search"] { min-width: 0; width: 100%; }
        .nav-links { display: none; }
        .table-wrap { overflow-x: auto; }
        th, td { padding: 8px 10px; font-size: 12px; }
        .top-deals { grid-template-columns: 1fr; }
      }
    </style>
  </head>
  <body>
    <header>
      <div class="container">
        <nav>
          <a href="/" class="logo">llm<span>deals</span></a>
          <div class="nav-links">
            <a href="/">Top Opportunities</a>
            <a href="/opps">All</a>
            <a href="/changes">Changes</a>
            <a href="/api">API</a>
            <a href="/methodology">Methodology</a>
          </div>
        </nav>
      </div>
    </header>
    <main class="container">
      <slot />
    </main>
    <footer style="border-top:1px solid var(--border);padding:20px 0;font-size:12px;color:var(--text-dim)">
      <div class="container" style="display:flex;justify-content:space-between;flex-wrap:wrap;gap:8px">
        <span>Data verified from official provider sources. Scores are computed from official platform data. We never rank by sponsorship.</span>
        <span><a href="/api/v1/deals.json" style="color:var(--text-dim)">/api/v1/deals.json</a></span>
      </div>
    </footer>
  </body>
</html>
