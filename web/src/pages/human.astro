---
import Base from '../layouts/Base.astro';
import fs from 'node:fs';
import path from 'node:path';

const ROOT = path.resolve(process.cwd(), '../');
const activeDir = path.join(ROOT, 'data/active');
const files = fs.readdirSync(activeDir).filter(f => f.endsWith('.json') && !f.startsWith('_') && f !== 'selected.json');

const allTasks: Array<{slug:string; title:string; task:any}> = [];
for (const f of files) {
  const data = JSON.parse(fs.readFileSync(path.join(activeDir, f), 'utf8'));
  if (data.human_queue) {
    for (const task of data.human_queue) {
      allTasks.push({ slug: f.replace('.json',''), title: data.title, task });
    }
  }
}

// Sort: undone first, then by deadline
allTasks.sort((a, b) => {
  if (a.task.done !== b.task.done) return a.task.done ? 1 : -1;
  return (a.task.deadline || '9999').localeCompare(b.task.deadline || '9999');
});

const pending = allTasks.filter(t => !t.task.done);
const completed = allTasks.filter(t => t.task.done);

// Group by hackathon
const byHackathon: Record<string, Array<{slug:string; title:string; task:any}>> = {};
for (const t of allTasks) {
  if (!byHackathon[t.slug]) byHackathon[t.slug] = [];
  byHackathon[t.slug].push(t);
}
---

<Base title="Human Tasks - HackathonHelp">
  <section class="hero">
    <div class="eyebrow">What only you can do</div>
    <h1>Human Tasks</h1>
    <p class="subtitle">{pending.length} pending · {completed.length} done · Links and instructions for each</p>
  </section>

  {Object.entries(byHackathon).map(([slug, tasks]) => {
    const hackPending = tasks.filter(t => !t.task.done);
    const hackDone = tasks.filter(t => t.task.done);
    const deadlines = hackPending.map(t => t.task.deadline).filter(Boolean).sort();
    const earliest = deadlines[0] || '9999';
    const urgency = earliest <= '2026-09-01' ? 'urgent' : earliest <= '2026-09-04' ? 'soon' : 'normal';
    return (
      <section class={`hack-group ${urgency}`}>
        <div class="hack-header">
          <a href={`/active/${slug}`} class="hack-title">{tasks[0]?.title || slug}</a>
          <span class="hack-count">{hackPending.length} pending{hackDone.length > 0 ? ` · ${hackDone.length} done` : ''}</span>
        </div>
        {tasks.map(t => (
          <div class={`task-row ${t.task.done ? 'done' : ''}`}>
            <div class="task-check">{t.task.done ? '✓' : '☐'}</div>
            <div class="task-body">
              <div class="task-name">{t.task.task}</div>
              {t.task.note && <div class="task-note">{t.task.note}</div>}
            </div>
            <div class="task-meta">
              {t.task.deadline && <span class="task-dl">{t.task.deadline}</span>}
              {t.task.url && <a href={t.task.url} target="_blank" rel="noopener" class="task-link">Open ↗</a>}
            </div>
          </div>
        ))}
      </section>
    );
  })}

  <style>
    .hack-group{background:var(--surface);border:1px solid var(--border);border-radius:12px;padding:16px;margin-bottom:12px}
    .hack-group.urgent{border-color:rgba(239,68,68,.4);background:linear-gradient(135deg,rgba(239,68,68,.05),rgba(239,68,68,.02))}
    .hack-group.soon{border-color:rgba(249,115,22,.3);background:linear-gradient(135deg,rgba(249,115,22,.05),rgba(249,115,22,.02))}
    .hack-header{display:flex;justify-content:space-between;align-items:center;margin-bottom:10px}
    .hack-title{font-size:16px;font-weight:700;color:var(--text);text-decoration:none}
    .hack-title:hover{color:var(--accent)}
    .hack-count{font-size:12px;color:var(--text-dim)}
    .task-row{display:flex;gap:10px;padding:8px 0;border-bottom:1px solid rgba(255,255,255,.05);align-items:flex-start}
    .task-row:last-child{border-bottom:none}
    .task-row.done{opacity:.45}
    .task-check{font-size:18px;width:24px;text-align:center;color:var(--accent);flex-shrink:0}
    .task-row.done .task-check{color:#86efac}
    .task-body{flex:1;min-width:0}
    .task-name{font-size:14px;font-weight:600;color:var(--text)}
    .task-note{font-size:12px;color:var(--text-muted);margin-top:2px;line-height:1.4}
    .task-meta{display:flex;gap:10px;align-items:center;flex-shrink:0}
    .task-dl{font-size:11px;font-weight:600;color:var(--text-dim);font-family:monospace}
    .task-dl.urgent{color:#ef4444}
    .task-dl.soon{color:#f97316}
    .task-link{font-size:11px;font-weight:700;color:var(--accent);text-decoration:none;white-space:nowrap}
    .task-link:hover{text-decoration:underline}
  </style>
</Base>
