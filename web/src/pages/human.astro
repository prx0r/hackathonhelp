---
import Base from '../layouts/Base.astro';
import fs from 'node:fs';
import path from 'node:path';

const ROOT = path.resolve(process.cwd(), '../');
const activeDir = path.join(ROOT, 'data/active');
const files = fs.readdirSync(activeDir).filter(f => f.endsWith('.json') && !f.startsWith('_') && f !== 'selected.json');

interface Task { task: string; url: string; deadline: string; done: boolean; note: string; type: string; }
interface Entry { slug: string; title: string; task: Task; }

const allTasks: Entry[] = [];
for (const f of files) {
  const data = JSON.parse(fs.readFileSync(path.join(activeDir, f), 'utf8'));
  if (data.human_queue) {
    for (const task of data.human_queue) {
      allTasks.push({ slug: f.replace('.json',''), title: data.title, task });
    }
  }
}

// Separate official deadlines from guide tasks
const official = allTasks.filter(t => t.task.type === 'official' && !t.task.done).sort((a, b) => (a.task.deadline || '9999').localeCompare(b.task.deadline || '9999'));
const guide = allTasks.filter(t => t.task.type === 'guide' && !t.task.done);
const completed = allTasks.filter(t => t.task.done);

// Group guide by hackathon
const guideByHack: Record<string, Entry[]> = {};
for (const t of guide) {
  if (!guideByHack[t.slug]) guideByHack[t.slug] = [];
  guideByHack[t.slug].push(t);
}
---

<Base title="Tasks - HackathonHelp">
  <section class="hero">
    <div class="eyebrow">What only you can do</div>
    <h1>Tasks</h1>
    <p class="subtitle">{official.length} deadlines · {guide.length} setup steps · {completed.length} done</p>
  </section>

  {/* OFFICIAL DEADLINES — hard cutoffs */}
  {official.length > 0 && (
  <section class="panel official-panel">
    <div class="label" style="color:#ef4444">⏰ Official Deadlines — hard cutoffs</div>
    <div class="official-grid">
      {official.map(t => (
        <div class="official-row">
          <div class="od-date">{t.task.deadline}</div>
          <div class="od-body">
            <div class="od-hack"><a href={`/active/${t.slug}`}>{t.title}</a></div>
            <div class="od-task">{t.task.task}</div>
          </div>
          {t.task.url && <a href={t.task.url} target="_blank" rel="noopener" class="od-link">Go ↗</a>}
        </div>
      ))}
    </div>
  </section>
  )}

  {/* GUIDE — setup steps grouped by hackathon */}
  {Object.entries(guideByHack).map(([slug, tasks]) => (
  <section class="panel guide-panel">
    <div class="label">📋 Setup Guide — {tasks[0]?.title || slug}</div>
    <div class="guide-list">
      {tasks.map(t => (
        <div class={`guide-row ${t.task.done ? 'done' : ''}`}>
          <div class="gr-check">{t.task.done ? '✓' : '○'}</div>
          <div class="gr-body">
            <div class="gr-task">{t.task.task}</div>
            {t.task.note && <div class="gr-note">{t.task.note}</div>}
          </div>
          {t.task.url && <a href={t.task.url} target="_blank" rel="noopener" class="gr-link">Open ↗</a>}
        </div>
      ))}
    </div>
  </section>
  ))}

  {completed.length > 0 && (
  <details class="panel done-panel">
    <summary class="label" style="color:#86efac">✓ Completed ({completed.length})</summary>
    {completed.map(t => (
      <div class="done-row">
        <span class="dr-check">✓</span>
        <span class="dr-text">{t.title}: {t.task.task}</span>
      </div>
    ))}
  </details>
  )}

  <style>
    .official-panel{border-color:rgba(239,68,68,.4);background:linear-gradient(135deg,rgba(239,68,68,.06),rgba(239,68,68,.02))}
    .official-grid{display:flex;flex-direction:column;gap:2px}
    .official-row{display:flex;gap:12px;padding:12px 0;border-bottom:1px solid rgba(255,255,255,.06);align-items:center}
    .official-row:last-child{border-bottom:none}
    .od-date{font-family:monospace;font-size:14px;font-weight:800;color:#ef4444;min-width:80px;flex-shrink:0}
    .od-body{flex:1;min-width:0}
    .od-hack{font-size:12px;color:var(--text-dim)}
    .od-hack a{color:var(--text-dim);text-decoration:none}
    .od-hack a:hover{color:var(--accent)}
    .od-task{font-size:14px;font-weight:600;color:var(--text)}
    .od-link{background:rgba(239,68,68,.15);color:#fca5a5;font-size:11px;font-weight:700;padding:4px 10px;border-radius:6px;text-decoration:none;white-space:nowrap}
    .od-link:hover{background:rgba(239,68,68,.25)}

    .guide-panel{border-color:var(--border)}
    .guide-list{display:flex;flex-direction:column;gap:0}
    .guide-row{display:flex;gap:10px;padding:8px 0;border-bottom:1px solid rgba(255,255,255,.04);align-items:flex-start}
    .guide-row:last-child{border-bottom:none}
    .guide-row.done{opacity:.4}
    .gr-check{font-size:14px;width:20px;text-align:center;color:var(--text-dim);flex-shrink:0;padding-top:2px}
    .guide-row.done .gr-check{color:#86efac}
    .gr-body{flex:1;min-width:0}
    .gr-task{font-size:13px;font-weight:500;color:var(--text)}
    .gr-note{font-size:11px;color:var(--text-muted);margin-top:2px;line-height:1.4}
    .gr-link{font-size:11px;font-weight:600;color:var(--accent);text-decoration:none;white-space:nowrap;flex-shrink:0}
    .gr-link:hover{text-decoration:underline}

    .done-panel summary{cursor:pointer}
    .done-row{display:flex;gap:8px;padding:4px 0;font-size:12px;color:var(--text-dim)}
    .dr-check{color:#86efac}
  </style>
</Base>
