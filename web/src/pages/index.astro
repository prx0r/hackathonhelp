---
import Base from '../layouts/Base.astro';
import derived from '../data/derived.json';




const megas = derived.opportunities.filter(o => o.status !== 'ended' && o.eligibility.eligible && o.mega).sort((a,b)=>b.mega.score-a.mega.score);
// Grid = actionable only: attention>0 excludes <3-day events and TBA deadlines
const open = derived.opportunities.filter(o => o.status !== 'ended' && o.eligibility.eligible && o.attention > 0);
const toolate = derived.opportunities.filter(o => o.status==='open' && o.eligibility.eligible && o.attention <= 0 && o.metrics.days_left != null && o.metrics.days_left >= 0);
// LIVE = usable field or closing soon; UPCOMING/FORMING = field still maturing
const live = open.filter(o => o.field.field_status==='usable')
  .sort((a,b)=>b.score_v01.opportunity_score-a.score_v01.opportunity_score);
const upcoming = open.filter(o => o.field.field_status==='forming')
  .sort((a,b)=>(b.prize.normalized_value??b.prize.advertised_value??0)-(a.prize.normalized_value??a.prize.advertised_value??0));

function fmt$(v){ return v==null?'—':'$'+Math.round(v).toLocaleString(); }
function esc(s){ return String(s??'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }

function daysLeft(o){ return o.metrics.days_left; }
function timeColor(d){
  if (d==null) return {bg:'rgba(148,163,184,0.08)', border:'var(--border)', text:'var(--text-dim)', label:'TBA'};
  if (d<0) return {bg:'rgba(100,116,139,0.10)', border:'rgba(100,116,139,0.25)', text:'var(--text-dim)', label:'ended'};
  if (d<=1) return {bg:'rgba(239,68,68,0.18)', border:'rgba(239,68,68,0.55)', text:'#fca5a5', label:d+'d'};
  if (d<=3) return {bg:'rgba(249,115,22,0.16)', border:'rgba(249,115,22,0.45)', text:'#fdba74', label:d+'d'};
  if (d<=7) return {bg:'rgba(234,179,8,0.13)', border:'rgba(234,179,8,0.38)', text:'#fde047', label:d+'d'};
  if (d<=14) return {bg:'rgba(34,197,94,0.12)', border:'rgba(34,197,94,0.35)', text:'#86efac', label:d+'d'};
  if (d<=30) return {bg:'rgba(59,130,246,0.12)', border:'rgba(59,130,246,0.35)', text:'#93c5fd', label:d+'d'};
  return {bg:'rgba(99,102,241,0.10)', border:'rgba(99,102,241,0.30)', text:'#a5b4fc', label:d+'d+'};
}

function oppCard(o,i){
  const m=o.metrics;
  return `<div class="deal-full">
    <div class="deal-rank">#${i+1}</div>
    <div class="deal-body">
      <div class="deal-head"><h3 class="deal-title">${esc(o.title)}</h3><span class="deal-tagline">${esc(o.organizer||'')} · ${o.location_type}${o.time_left?' · '+esc(o.time_left):''}</span></div>
      <div class="deal-section"><div class="deal-section-label">Prize</div><div class="deal-section-text"><span style="font-weight:800;color:var(--accent);font-size:17px">${fmt$(o.prize.normalized_value)}</span>${o.prize.credits_value?` <span style="font-size:11px;color:var(--text-dim)">incl. $${Math.round(o.prize.credits_value).toLocaleString()} credits</span>`:''}</div></div>
      <div class="deal-section"><div class="deal-section-label">Competition</div><div class="deal-section-text">${(o.registrants||0).toLocaleString()} registered${o.field.estimated_serious_field?` · ~${o.field.estimated_serious_field.toLocaleString()} est. serious projects`:''}${m.fair_share_serious!=null?` · <strong>$${m.fair_share_serious.toLocaleString()}/submission</strong>`:''}</div></div>
      ${o.themes.length?`<div class="deal-section"><div class="deal-section-label">Themes</div><div class="deal-section-text">${o.themes.slice(0,4).map(esc).join(' · ')}</div></div>`:''}
      <div class="deal-footer"><a href="/opps/${o.slug}" class="deal-link">Full analysis</a><span style="color:var(--border)">|</span><a href="${o.source_url}" target="_blank" rel="noopener" class="deal-link">Register →</a></div>
    </div></div>`;
}

const megaRowsHtml = megas.slice(0,10).map(o=>`
  <tr style="cursor:pointer" onclick="window.location='/opps/${o.slug}'">
    <td class="price" style="color:var(--accent);font-weight:800;font-size:15px">${o.mega.score}</td>
    <td><div class="model-name">${esc(o.title)}</div><div class="model-sub">${o.mega.reasons.join(' · ')}</div></td>
    <td style="font-variant-numeric:tabular-nums;font-weight:700">${fmt$(o.prize_usd)}</td>
    <td style="font-variant-numeric:tabular-nums">${(o.registrants||0).toLocaleString()}</td>
    <td class="price price-input">$${o.metrics.equal_share ?? '—'}</td>
    <td style="font-size:12px;color:${o.metrics.days_left<=7?'var(--orange)':'var(--text-dim)'}">${o.time_left||'—'}</td>
  </tr>`).join('');

const tableRows = JSON.stringify(open.map(o=>({
  slug:o.slug, title:o.title, prize:o.prize_usd, reg:o.registrants,
  share:o.metrics.equal_share, score:o.metrics.opportunity_score,
  days:o.metrics.days_left, loc:o.location_type, themes:o.themes.join(' '), status:o.status,
})));

const tilesHtml = open.map(o => {
  const c = timeColor(daysLeft(o));
  const score = o.score_v01.opportunity_score;
  return `<a class="tile" style="background:${c.bg};border-color:${c.border}" href="/opps/${o.slug}">
          <div class="tile-top">
            <span class="tile-score">${score ?? '—'}</span>
            ${o.mega?`<span class="tile-mega">🔥</span>`:''}
          </div>
          <div class="tile-title">${esc(o.title)}</div>
          <div class="tile-org">${esc(o.organizer||'')}</div>
          <div class="tile-bottom">
            <span class="tile-prize">${fmt$(o.prize.normalized_value ?? o.prize.advertised_value)}</span>
            <span class="tile-days" style="color:${c.text}">${c.label}</span>
          </div>
        </a>`;
}).join('');
---
<Base title="HackathonHelp - Hackathons actually worth entering">
  <section class="hero">
    <div class="eyebrow">Opportunity intelligence for builders</div>
    <h1>Hackathons worth entering</h1>
    <p class="subtitle">Tracking {derived.counts.opportunities} events for online individual builders — no student-only, no age-gated noise. Prize pools normalized to real cash, fields estimated from historical submission rates, so you see expected value per serious competitor, not headline numbers. Updated {new Date().toISOString().slice(0,10)}.</p>
  </section>

  <section style="margin-bottom:48px">
    <div class="section-header">
      <h2>Opportunity grid</h2>
      <span class="stats">{open.length} live events · tile colour = time left (red → blue)</span>
    </div>
    <div class="tile-grid" set:html={tilesHtml} />
    <p class="mathnote" style="margin-top:10px;font-size:11px;color:var(--text-dim)">Ordered by attention (score × time-window). Colour scale: red ≤1d · orange ≤3d · yellow ≤7d · green ≤14d · blue ≤30d · indigo 30d+. Events under 3 days are hidden — too late to build anything real.{toolate.length ? ` ${toolate.length} event${toolate.length>1?'s':''} in final sprint hidden.` : ''}</p>
  </section>
  </section>

  <section style="margin-bottom:48px">
    <div class="section-header">
      <h2>🔥 Best live now</h2>
      <span class="stats">fields matured — scores reflect real competition</span>
    </div>
    <div class="deal-list" set:html={live.slice(0,4).map((o,i)=>oppCard(o,i)).join('')} />
  </section>

  <section style="margin-bottom:48px">
    <div class="section-header">
      <h2>📅 Best coming up</h2>
      <span class="stats">fields still forming — register early, rescored daily as entrants grow</span>
    </div>
    <div class="deal-list" set:html={upcoming.slice(0,4).map((o,i)=>oppCard(o,i)).join('')} />
  </section>

  <section style="margin-bottom:48px">
    <div class="section-header">
      <h2>🔥 Mega opportunities</h2>
      <span class="stats">high fair-share ÷ low competition — full rules on /methodology</span>
    </div>
    <div class="table-wrap">
      <table>
        <thead><tr><th>Score</th><th>Event</th><th>Prize</th><th>Entrants</th><th>Fair-share/entrant</th><th>Deadline</th></tr></thead>
        <tbody set:html={megaRowsHtml} />
      </table>
    </div>
  </section>

  <section>
    <div class="section-header">
      <h2>All live opportunities</h2>
      <span class="stats">{open.length} events</span>
    </div>
    <div class="toolbar">
      <div style="display:flex;gap:8px;flex-wrap:wrap">
        <input type="search" id="q" placeholder="Search title, organizer, theme..." />
        <select id="f-loc"><option value="">Online + IRL</option><option value="online">Online only</option><option value="in-person">In-person</option></select>
      </div>
      <div class="stats" id="stats"></div>
    </div>
    <div class="table-wrap">
      <table>
        <thead><tr>
          <th data-col="score" data-num>Score</th><th>Event</th><th data-col="prize" data-num>Prize</th>
          <th data-col="reg" data-num>Entrants</th><th data-col="share" data-num>Fair-share</th><th data-col="days" data-num>Days left</th>
        </tr></thead>
        <tbody id="tbody"></tbody>
      </table>
    </div>
  </section>

  <script define:vars={{ rows: tableRows }}>
    const all = JSON.parse(rows);
    let sort = {col:'score', dir:'desc'};
    function render(){
      const q=(document.getElementById('q')?.value||'').toLowerCase();
      const fl=document.getElementById('f-loc')?.value||'';
      let f=all.filter(r=>{
        if(q && !(r.title+r.themes).toLowerCase().includes(q)) return false;
        if(fl && r.loc!==fl) return false;
        return true;});
      f.sort((a,b)=>{let va=a[sort.col]??-1,vb=b[sort.col]??-1;return sort.dir==='asc'?va-vb:vb-va;});
      document.getElementById('tbody').innerHTML=f.map(r=>`<tr style="cursor:pointer" onclick="window.location='/opps/${r.slug}'">
        <td class="price" style="color:var(--accent);font-weight:800">${r.status==='closing_soon'?'⏳ ':''}${r.score}</td>
        <td><div class="model-name">${r.title}</div><div class="model-sub">${r.loc}</div></td>
        <td class="price">$${r.prize!=null?Math.round(r.prize).toLocaleString():'—'}</td>
        <td style="font-variant-numeric:tabular-nums">${r.reg!=null?r.reg.toLocaleString():'—'}</td>
        <td class="price price-input">${r.share!=null?'$'+r.share:'—'}</td>
        <td style="font-size:12px;color:${r.days!=null&&r.days<=7?'var(--orange)':'var(--text-dim)'}">${r.days==null?'—':r.days<0?'ended':r.days+'d'}</td>
      </tr>`).join('');
      document.getElementById('stats').textContent=f.length+' events';
    }
    document.querySelectorAll('th[data-col]').forEach(th=>th.addEventListener('click',()=>{
      const c=th.dataset.col;
      if(sort.col===c) sort.dir=sort.dir==='asc'?'desc':'asc'; else {sort.col=c;sort.dir='desc';}
      render();}));
    document.getElementById('q')?.addEventListener('input',render);
    document.getElementById('f-loc')?.addEventListener('change',render);
    render();
  </script>
</Base>
