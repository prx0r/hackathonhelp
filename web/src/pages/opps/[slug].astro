---
import Base from '../../layouts/Base.astro';
import derived from '../../data/derived.json';

export function getStaticPaths(){
  return derived.opportunities.map(o=>({params:{slug:o.slug},props:{o}}));
}
const { o } = Astro.props;
const m = o.metrics;
const fmt$ = v => v==null?'—':'$'+Math.round(v).toLocaleString();
const dl = m.days_left;
const ended = o.status==='ended' || (dl!=null && dl<0);
const scoreNull = o.score_v01.opportunity_score == null;
---
<Base title={`${o.title} - HackathonHelp`}>
  <a href="/opps" class="back">All opportunities</a>
  <section class="head">
    <div class="provider-line"><span class="pdot"></span>{o.organizer} · {o.location} · {o.location_type}</div>
    <h1>{o.title}</h1>
    <div class="badges">
      {!ended && <a class="register-btn" href={o.source_url} target="_blank" rel="noopener">Register on official page ↗</a>}
      {!scoreNull && <span class="score">{o.score_v01.opportunity_score}/100</span>}
      {ended && <span class="conf" style="color:var(--red)">submission closed</span>}
      {!ended && o.time_left && <span class="conf">{o.time_left}</span>}
      {o.field.field_status==='forming' && !ended && <span class="pill-forming">field still forming</span>}
    </div>
  </section>

  {!o.eligibility.eligible && (
    <section class="panel excluded-panel">
      <div class="label" style="color:var(--red)">Not eligible — excluded from rankings</div>
      <p>{o.eligibility.failed.join(' · ')}</p>
      <p class="mathnote">Official rules override platform metadata. Listed for transparency.</p>
    </section>
  )}

  {o.mega && (
    <section class="panel verdict">
      <div class="label">Why it's flagged 🔥</div>
      <p>{o.mega.reasons.map(r=>'• '+r).join('  ·  ')}</p>
    </section>
  )}

  {o.cautions && o.cautions.length > 0 && (
    <section class="panel caution-panel">
      <div class="label" style="color:var(--orange)">Verify before committing</div>
      <p>{o.cautions.map(c=>'• '+c).join(' · ')}</p>
    </section>
  )}

  <section class="panel decision-panel">
    <div class="label">Decision — what to do today</div>
    <div class="decision-row">
      <span class={'action-big act-'+o.decision.action.replace(/ /g,'')}>{o.decision.action}</span>
      <div class="decision-reason">{o.decision.reason}</div>
    </div>
    <table class="math" style="margin-top:10px">
      <tr><td>Finish-feasibility at deadline</td><td>{Math.round(o.decision.p_finish_proxy*100)}% <span style="color:var(--text-dim)">({o.decision.feasibility_label})</span></td></tr>
      <tr><td>P(any payout) if competitive entry</td><td>{o.payout.baseline_any_payout!=null? Math.round(o.payout.baseline_any_payout*100)+'%':'—'} <span style="color:var(--text-dim)">(assumes {o.payout.paying_slots.p50}-{o.payout.paying_slots.p90} slots)</span></td></tr>
      <tr><td>Heuristic cash EV</td><td>{o.payout.ev_cash_heuristic!=null? '$'+o.payout.ev_cash_heuristic.toLocaleString():'—'}</td></tr>
      <tr><td>Build model</td><td>P50 {o.decision.build_model.p50_hours}h / P80 {o.decision.build_model.p80_hours}h at {o.decision.build_model.hours_per_day}h per day</td></tr>
      {o.decision.latest_safe_start && <tr><td>Latest safe start</td><td>{o.decision.latest_safe_start}</td></tr>}
    </table>
  </section>

  <section class="grid2">
    <div class="panel">
      <div class="label">Prize normalization</div>
      <table class="math">
        <tr><td>Headline advertised</td><td>{o.prize.advertised_value!=null? '$'+Math.round(o.prize.advertised_value).toLocaleString():'TBA'}</td></tr>
        <tr class="hl"><td>Cash (verified)</td><td>{o.prize.cash_value!=null?'$'+Math.round(o.prize.cash_value).toLocaleString():'unconfirmed'}</td></tr>
        <tr><td>Credits (compute/API)</td><td>{o.prize.credits_value!=null?'$'+Math.round(o.prize.credits_value).toLocaleString():'—'}</td></tr>
        <tr class="hl"><td>Normalized value</td><td>{o.prize.normalized_value!=null?'$'+Math.round(o.prize.normalized_value).toLocaleString():'—'}</td></tr>
        {o.prize.headline_inflation != null && o.prize.headline_inflation > 0 &&
          <tr><td>Headline inflation</td><td style="color:var(--orange)">{o.prize.headline_inflation}% non-cash</td></tr>}
      </table>
      <a href={o.source_url} target="_blank" rel="noopener" class="src-link">Official event page →</a>
      <div class="observed">Devpost API · observed {o.observed_at.slice(0,10)} · eligibility source: {o.eligibility.confidence.replace(/_/g,' ')}</div>
    </div>

    <div class="panel">
      <div class="label">Field estimation</div>
      <table class="math">
        <tr><td>Registered</td><td>{(o.field.registrations??0).toLocaleString()}</td></tr>
        <tr><td>Submission prior</td><td>{Math.round(o.field.family_prior.submissions_per_registration*100)}%</td></tr>
        <tr class="hl"><td>Est. serious field</td><td>{o.field.field_status==='usable'? '~'+o.field.estimated_serious_field.toLocaleString()+' projects':'still forming'}</td></tr>
        {m.fair_share_serious != null &&
          <tr class="hl"><td>Norm. prize per est. submission</td><td>${m.fair_share_serious.toLocaleString()}</td></tr>}
        <tr><td>Days left</td><td>{dl ?? '—'}</td></tr>
      </table>
      {o.field.field_status==='forming' && <p class="mathnote" style="margin-top:8px">Registration counts grow toward the deadline. Score leans on organizer quality + prize data until the field matures.</p>}
    </div>
  </section>

  <section class="panel">
    <div class="label">Score breakdown v0.1</div>
    {scoreNull ? (
      <p class="mathnote">Not scored — eligibility gate failed.</p>
    ) : (
      <>
      <div class="scorebig">{o.score_v01.opportunity_score}<span>/100</span></div>
      <p class="mathnote" style="margin-bottom:10px">
        <strong>Grid order (attention)</strong> = {o.attention_breakdown.score} × {o.attention_breakdown.urgency_multiplier}
        ({o.attention_breakdown.days_left==null?'deadline TBA':o.attention_breakdown.days_left+' days left'}) = <strong>{o.attention}</strong>
      </p>
      {o.prize_raw && o.prize_raw !== '$0' && (
        <p class="mathnote" style="margin-bottom:8px">Platform-listed prize: <strong>{o.prize_raw}</strong></p>
      )}
      <table class="math">
        {Object.entries(o.score_v01.components).map(([k,v]) => (
          <tr><td>{k.replace(/_/g,' ')}</td><td>{v!=null? v+'/100' : 'no data yet'}</td></tr>
        ))}
      </table>
      <p class="mathnote" style="margin-top:8px">Known components renormalized · completeness bonus up to +8 · unverified prizes capped at 85.</p>
      </>
    )}
  </section>

  <section class="panel">
    <div class="label">The facts</div>
    <ul class="terms">
      <li><strong>Dates:</strong> {o.starts_at && new Date(o.starts_at).toLocaleDateString()} → {o.ends_at && new Date(o.ends_at).toLocaleDateString()}</li>
      <li><strong>Format:</strong> {o.location_type}{o.open_to_all?'':' · restricted entry'}</li>
      {o.themes.length>0 && <li><strong>Themes:</strong> {o.themes.join(', ')}</li>}
      {o.eligibility.notes && <li><strong>Research note:</strong> {o.eligibility.notes}</li>}
    </ul>
  </section>
<script type="application/ld+json" set:html={JSON.stringify({
  '@context':'https://schema.org',
  '@type':'Event',
  name:o.title,
  organizer:{'@type':'Organization',name:o.organizer||o.title},
  eventStatus:o.status==='ended'?'https://schema.org/EventScheduled':'https://schema.org/EventScheduled',
  eventAttendanceMode:o.location_type==='online'?'https://schema.org/OnlineEventAttendanceMode':'https://schema.org/OfflineEventAttendanceMode',
  startDate:o.starts_at||undefined,
  endDate:o.ends_at||undefined,
  location:o.location_type==='online'?{'@type':'VirtualLocation',url:o.source_url}:{'@type':'Place',name:o.location},
  offers:{'@type':'Offer',price:o.prize.normalized_value??0,priceCurrency:'USD',url:o.source_url,availability:o.status==='ended'?'https://schema.org/SoldOut':'https://schema.org/InStock'},
  url:o.source_url,
  description:`Opportunity score ${o.score_v01.opportunity_score??'n/a'}. Action: ${o.decision.action}. ${o.decision.reason}`
})} />
</Base>

<style>
  .back{font-size:13px;color:var(--text-dim);display:inline-block;margin-bottom:20px}
  .provider-line{display:flex;align-items:center;gap:8px;font-size:13px;color:var(--text-dim);margin-bottom:8px}
  .pdot{width:8px;height:8px;border-radius:50%;background:var(--accent);display:inline-block}
  h1{font-size:clamp(24px,4vw,36px);letter-spacing:-.03em}
  .badges{display:flex;gap:12px;align-items:center;margin-top:10px;flex-wrap:wrap}
  .score{background:rgba(249,115,22,.15);color:var(--accent);padding:3px 10px;border-radius:6px;font-weight:800;font-size:14px}
  .pill-forming{background:rgba(59,130,246,.15);color:var(--blue);padding:3px 10px;border-radius:6px;font-size:12px;font-weight:600}
  .conf{color:var(--text-dim);font-size:12px}
  .panel{background:var(--surface);border:1px solid var(--border);border-radius:12px;padding:20px;margin-bottom:14px}
  .verdict p{font-size:15px;line-height:1.6;color:var(--text)}
  .excluded-panel p, .caution-panel p{font-size:13px;line-height:1.7;color:var(--text-muted)}
  .label{font-size:10px;text-transform:uppercase;letter-spacing:.07em;font-weight:700;color:var(--accent);margin-bottom:8px}
  .grid2{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-bottom:14px}
  .terms{margin:0;padding-left:18px}
  .terms li{font-size:13px;color:var(--text-muted);margin-bottom:7px;line-height:1.5}
  .terms strong{color:var(--text)}
  .src-link{display:inline-block;margin-top:10px;font-size:12px;font-weight:600}
  .observed{font-size:11px;color:var(--text-dim);margin-top:6px}
  .register-btn{background:var(--accent);color:#431407 !important;font-weight:800;font-size:12px;padding:6px 14px;border-radius:8px;text-decoration:none !important}
  .math td{padding:5px 0;font-size:13px;color:var(--text-muted)}
  .math td:last-child{text-align:right;color:var(--text);font-variant-numeric:tabular-nums;font-weight:600}
  .math tr.hl td{color:var(--accent);font-weight:800}
  .mathnote{font-size:13px;color:var(--text-muted);line-height:1.6}
  .decision-panel .decision-row{display:flex;align-items:center;gap:14px;margin-bottom:6px}
  .action-big{font-size:20px;font-weight:900;padding:6px 16px;border-radius:9px;text-transform:uppercase}
  .act-ENTERNOW{background:rgba(34,197,94,.18);color:#86efac}
  .act-SPRINT{background:rgba(249,115,22,.18);color:#fdba74}
  .act-PREP{background:rgba(59,130,246,.15);color:#93c5fd}
  .act-WATCH{background:rgba(148,163,163,.15);color:var(--text-dim)}
  .act-SKIP{background:rgba(239,68,68,.12);color:#fca5a5}
  .act-ENDED{background:rgba(100,116,139,.12);color:var(--text-dim)}
  .scorebig{font-size:42px;font-weight:900;color:var(--accent);letter-spacing:-.03em;margin-bottom:8px}
  @media(max-width:700px){.grid2{grid-template-columns:1fr}}
</style>
