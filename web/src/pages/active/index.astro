---
import Base from '../../layouts/Base.astro';
import fs from 'node:fs';
import path from 'node:path';

const ROOT = path.resolve(process.cwd(), '../..');
const selected = JSON.parse(fs.readFileSync(path.join(ROOT, 'data/active/selected.json'), 'utf8'));
const seed = JSON.parse(fs.readFileSync(path.join(ROOT, 'data/seed.json'), 'utf8'));

const seedBySlug = Object.fromEntries(seed.opportunities.map((o:any) => [o.slug, o]));
const activeDir = path.join(ROOT, 'data/active');

function esc(x){ return String(x??"").replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;"); }
function fmtDate(d){ return d ? new Date(d).toLocaleDateString('en-US',{month:'short',day:'numeric'}) : null; }

const tiles = selected.selected.map((slug:string) => {
  let data:any = null;
  const activePath = path.join(activeDir, `${slug}.json`);
  if (fs.existsSync(activePath)) {
    data = JSON.parse(fs.readFileSync(activePath, 'utf8'));
  }
  const seedEntry = seedBySlug[slug] || {};
  const isOncoming = selected.oncoming?.includes(slug) ?? false;
  const deadline = data?.timeline?.build_deadline || data?.timeline?.registration_closes || seedEntry.ends_at || null;
  const dl = deadline ? Math.ceil((new Date(deadline) - Date.now()) / 86400000) : null;
  const urgent = dl != null && dl <= 7;
  const soon = dl != null && dl <= 14;
  const bg = isOncoming ? 'rgba(148,163,163,.06)' : urgent ? 'rgba(249,115,22,.08)' : soon ? 'rgba(234,179,8,.06)' : 'rgba(34,197,94,.05)';
  const border = isOncoming ? 'var(--border)' : urgent ? 'rgba(249,115,22,.35)' : soon ? 'rgba(234,179,8,.25)' : 'rgba(34,197,94,.2)';
  const dayColor = isOncoming ? 'var(--text-dim)' : urgent ? '#fb923c' : soon ? '#facc15' : '#86efac';
  const dayLabel = isOncoming ? fmtDate(deadline) : (dl != null ? (dl < 0 ? 'ended' : dl + 'd') : 'TBA');
  const title = data?.title || seedEntry.title || slug;
  const prize = data?.prizes?.total_usd || seedEntry.prize_usd || null;
  const prizeAlgo = data?.prizes?.total_algo || null;
  const howToWin = data?.judging?.how_to_win || [];
  const hasDetail = !!data;

  return `<a href="/active/${slug}" class="tile" style="background:${bg};border-color:${border}">
    <div class="tile-top">
      <span class="tile-status ${isOncoming ? 'status-oncoming' : 'status-active'}">${isOncoming ? 'ONCOMING' : 'BUILDING'}</span>
      <span class="tile-detail${hasDetail ? '' : ' dim'}">${hasDetail ? '●' : '○'}</span>
    </div>
    <div class="tile-title">${esc(title)}</div>
    <div class="tile-bottom">
      <span class="tile-prize">${prize ? '$'+prize.toLocaleString() : 'TBA'}${prizeAlgo ? ' +'+prizeAlgo.toLocaleString()+' ALGO' : ''}</span>
      <span class="tile-days" style="color:${dayColor}">${dayLabel || 'TBA'}</span>
    </div>
    ${howToWin.length > 0 ? '<div class="tile-preview">→ ' + esc(howToWin[0]) + '</div>' : ''}
  </a>`;
}).join('');

const activeCount = tiles.filter((_,i) => !selected.oncoming?.includes(selected.selected[i])).length;
const oncomingCount = tiles.length - activeCount;
---
<Base title="Active - HackathonHelp">
  <section class="hero">
    <div class="eyebrow">What we're building</div>
    <h1>Active</h1>
    <p class="subtitle">{activeCount} hackathon{activeCount!==1?'s':''} selected · {oncomingCount} oncoming · click for full rubric & checklist</p>
  </section>

  <div class="tile-grid" set:html={tiles} />

  {oncomingCount > 0 && (
    <p class="section-note">Oncoming = selected but not yet building. They'll move to active when you start.</p>
  )}

  <section class="panel" style="margin-top:32px">
    <div class="label">How to add / remove</div>
    <p class="mathnote">Edit <code>data/active/selected.json</code> — add a slug to <code>selected[]</code> to track it, move to <code>oncoming[]</code> if not open yet. Crawl details with <code>scripts/crawl-active.sh</code>.</p>
  </section>
</Base>

<style>
  .hero{margin-bottom:32px}
  .eyebrow{color:var(--accent);text-transform:uppercase;letter-spacing:.08em;font-size:11px;font-weight:700;margin-bottom:8px}
  h1{font-size:clamp(28px,4vw,42px);font-weight:800;letter-spacing:-.03em;line-height:1.1;margin-bottom:8px}
  .subtitle{color:var(--text-muted);font-size:15px;max-width:600px;line-height:1.6}

  .tile-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:14px;margin-bottom:16px}
  .tile{
    display:flex;flex-direction:column;justify-content:space-between;
    min-height:150px;padding:16px;border-radius:12px;
    border:1px solid var(--border);text-decoration:none !important;color:inherit;
    transition:transform .12s,box-shadow .12s,opacity .15s;
  }
  .tile:hover{transform:translateY(-3px);box-shadow:0 6px 20px rgba(0,0,0,.5)}
  .tile-top{display:flex;justify-content:space-between;align-items:center;margin-bottom:10px}
  .tile-status{font-size:9px;font-weight:800;padding:3px 8px;border-radius:5px;text-transform:uppercase;letter-spacing:.04em}
  .status-active{background:rgba(34,197,94,.15);color:#86efac}
  .status-oncoming{background:rgba(148,163,163,.12);color:var(--text-dim)}
  .tile-detail{font-size:10px}
  .tile-detail.dim{opacity:.4}
  .tile-title{font-size:16px;font-weight:700;line-height:1.3;margin-bottom:12px;flex:1}
  .tile-bottom{display:flex;justify-content:space-between;align-items:baseline}
  .tile-prize{font-size:14px;font-weight:800;color:var(--accent)}
  .tile-days{font-size:12px;font-weight:700}
  .tile-preview{font-size:11px;color:var(--text-muted);margin-top:8px;line-height:1.4;border-top:1px solid var(--border);padding-top:8px}

  .section-note{font-size:12px;color:var(--text-dim);margin-bottom:24px}

  .panel{background:var(--surface);border:1px solid var(--border);border-radius:12px;padding:20px;margin-bottom:14px}
  .label{font-size:10px;text-transform:uppercase;letter-spacing:.07em;font-weight:700;color:var(--accent);margin-bottom:8px}
  .mathnote{font-size:13px;color:var(--text-muted);line-height:1.6}
  .mathnote code{background:rgba(249,115,22,.12);color:var(--accent);padding:1px 5px;border-radius:4px;font-size:12px}
</style>
